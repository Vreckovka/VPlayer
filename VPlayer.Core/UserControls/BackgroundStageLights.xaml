<UserControl
  x:Class="VPlayer.Core.UserControls.BackgroundStageLights"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:VPlayer.Core.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">

  <UserControl.Resources>
    <Style x:Key="WeakBeamStyle" TargetType="Rectangle">
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="ImageBeamStyle" TargetType="Rectangle">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Color x:Key="WeakBeamPeakColor">#70FF00</Color>
    <Color x:Key="WeakBeamEdgeColor">#00000000</Color>

    <Color x:Key="ImageBeamPeakColor">#70FF00</Color>
    <Color x:Key="ImageBeamEdgeColor">#00000000</Color>
  </UserControl.Resources>


  <Grid>
    <Grid
      x:Name="VisibleBeamOverlay"
      Panel.ZIndex="0"
      IsHitTestVisible="False"
      Opacity="1">

      <Grid x:Name="WeakLight1Gate">
        <Rectangle Style="{StaticResource WeakBeamStyle}">
          <Rectangle.Fill>

            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">

              <LinearGradientBrush.RelativeTransform>

                <TransformGroup>

                  <ScaleTransform CenterX="0.15" CenterY="0" ScaleX="{Binding ScaleX, ElementName=Light1Scale}" ScaleY="{Binding ScaleY, ElementName=Light1Scale}" />

                  <RotateTransform Angle="{Binding Angle, ElementName=Light1Rotate}" CenterX="0.15" CenterY="0" />

                </TransformGroup>

              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0.00" Color="{StaticResource WeakBeamEdgeColor}" />

              <GradientStop Offset="0.00" Color="{StaticResource WeakBeamEdgeColor}" />

              <GradientStop Offset="0.15" Color="{DynamicResource WeakBeamPeakColor}" />

              <GradientStop Offset="0.30" Color="{StaticResource WeakBeamEdgeColor}" />

              <GradientStop Offset="1.00" Color="{StaticResource WeakBeamEdgeColor}" />

            </LinearGradientBrush>

          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Grid x:Name="WeakLight2Gate">
        <Rectangle Style="{StaticResource WeakBeamStyle}">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                  <ScaleTransform CenterX="0.30" CenterY="0" ScaleX="{Binding ScaleX, ElementName=Light2Scale}" ScaleY="{Binding ScaleY, ElementName=Light2Scale}" />
                  <RotateTransform Angle="{Binding Angle, ElementName=Light2Rotate}" CenterX="0.30" CenterY="0" />
                </TransformGroup>
              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0.00" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.15" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.30" Color="{DynamicResource WeakBeamPeakColor}" />
              <GradientStop Offset="0.45" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="1.00" Color="{StaticResource WeakBeamEdgeColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Grid x:Name="WeakLight3Gate">
        <Rectangle Style="{StaticResource WeakBeamStyle}">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                  <ScaleTransform CenterX="0.70" CenterY="0" ScaleX="{Binding ScaleX, ElementName=Light3Scale}" ScaleY="{Binding ScaleY, ElementName=Light3Scale}" />
                  <RotateTransform Angle="{Binding Angle, ElementName=Light3Rotate}" CenterX="0.70" CenterY="0" />
                </TransformGroup>
              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0.00" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.55" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.70" Color="{DynamicResource WeakBeamPeakColor}" />
              <GradientStop Offset="0.85" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="1.00" Color="{StaticResource WeakBeamEdgeColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Grid x:Name="WeakLight4Gate">
        <Rectangle Style="{StaticResource WeakBeamStyle}">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                  <ScaleTransform CenterX="0.85" CenterY="0" ScaleX="{Binding ScaleX, ElementName=Light4Scale}" ScaleY="{Binding ScaleY, ElementName=Light4Scale}" />
                  <RotateTransform Angle="{Binding Angle, ElementName=Light4Rotate}" CenterX="0.85" CenterY="0" />
                </TransformGroup>
              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0.00" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.70" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="0.85" Color="{DynamicResource WeakBeamPeakColor}" />
              <GradientStop Offset="1.00" Color="{StaticResource WeakBeamEdgeColor}" />
              <GradientStop Offset="1.00" Color="{StaticResource WeakBeamEdgeColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </Grid>

    <Grid
      x:Name="LightSweepOverlay"
      IsHitTestVisible="False"
      Opacity="1">

      <Rectangle x:Name="Light1Beam" Style="{StaticResource ImageBeamStyle}">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="Light1Scale" CenterX="0.15" CenterY="0" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="Light1Rotate" CenterX="0.15" CenterY="0" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0.00" Color="#00FFFFFF" />
            <GradientStop Offset="0.09" Color="#00FFFFFF" />
            <GradientStop Offset="0.15" Color="{DynamicResource ImageBeamPeakColor}" />
            <GradientStop Offset="0.21" Color="#00FFFFFF" />
            <GradientStop Offset="1.00" Color="#00FFFFFF" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Rectangle x:Name="Light2Beam" Style="{StaticResource ImageBeamStyle}">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="Light2Scale" CenterX="0.30" CenterY="0" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="Light2Rotate" CenterX="0.30" CenterY="0" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0.00" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.24" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.30" Color="{DynamicResource ImageBeamPeakColor}" />
            <GradientStop Offset="0.36" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="1.00" Color="{StaticResource ImageBeamEdgeColor}" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Rectangle x:Name="Light3Beam" Style="{StaticResource ImageBeamStyle}">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="Light3Scale" CenterX="0.70" CenterY="0" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="Light3Rotate" CenterX="0.70" CenterY="0" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0.00" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.64" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.70" Color="{DynamicResource ImageBeamPeakColor}" />
            <GradientStop Offset="0.76" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="1.00" Color="{StaticResource ImageBeamEdgeColor}" />

          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Rectangle x:Name="Light4Beam" Style="{StaticResource ImageBeamStyle}">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="Light4Scale" CenterX="0.85" CenterY="0" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="Light4Rotate" CenterX="0.85" CenterY="0" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0.00" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.79" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="0.85" Color="{DynamicResource ImageBeamPeakColor}" />
            <GradientStop Offset="0.91" Color="{StaticResource ImageBeamEdgeColor}" />
            <GradientStop Offset="1.00" Color="{StaticResource ImageBeamEdgeColor}" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Grid>
</UserControl>
