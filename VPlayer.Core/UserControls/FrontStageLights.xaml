<UserControl
  x:Class="VPlayer.Core.UserControls.FrontStageLights"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:VPlayer.Core.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style x:Key="FrontWeakBeamStyle" TargetType="Rectangle">
      <Setter Property="Opacity" Value="0.1" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="FrontImageBeamStyle" TargetType="Rectangle">
      <Setter Property="Opacity" Value="0.0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Color x:Key="FrontWeakBeamPeakColor">#fff</Color>
    <Color x:Key="FrontWeakBeamEdgeColor">#00000000</Color>
    <Color x:Key="FrontImageBeamPeakColor">#fff</Color>
    <Color x:Key="FrontImageBeamEdgeColor">#00000000</Color>
  </UserControl.Resources>

  <Grid ClipToBounds="True">

    <Grid
      x:Name="WeakBeamOverlay"
      IsHitTestVisible="False"
      Opacity="1">

      <Grid x:Name="FrontLight1WeakGate">
        <Rectangle Style="{StaticResource FrontWeakBeamStyle}">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                  <ScaleTransform CenterX="0.12" CenterY="1" ScaleX="{Binding ScaleX, ElementName=FrontLight1Scale}" ScaleY="{Binding ScaleY, ElementName=FrontLight1Scale}" />

                  <RotateTransform Angle="{Binding Angle, ElementName=FrontLight1Rotate}" CenterX="0.12" CenterY="1" />
                </TransformGroup>
              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="0" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="0.12" Color="{DynamicResource FrontWeakBeamPeakColor}" />
              <GradientStop Offset="0.42" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="1" Color="{StaticResource FrontWeakBeamEdgeColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>

      <Grid x:Name="FrontLight2WeakGate">
        <Rectangle Style="{StaticResource FrontWeakBeamStyle}">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <LinearGradientBrush.RelativeTransform>
                <TransformGroup>
                  <ScaleTransform CenterX="0.88" CenterY="1" ScaleX="{Binding ScaleX, ElementName=FrontLight2Scale}" ScaleY="{Binding ScaleY, ElementName=FrontLight2Scale}" />

                  <RotateTransform Angle="{Binding Angle, ElementName=FrontLight2Rotate}" CenterX="0.88" CenterY="1" />
                </TransformGroup>
              </LinearGradientBrush.RelativeTransform>

              <GradientStop Offset="0" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="0.58" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="0.88" Color="{DynamicResource FrontWeakBeamPeakColor}" />
              <GradientStop Offset="1" Color="{StaticResource FrontWeakBeamEdgeColor}" />
              <GradientStop Offset="1" Color="{StaticResource FrontWeakBeamEdgeColor}" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
    </Grid>

    <Grid
      x:Name="ImageBeamOverlay"
      IsHitTestVisible="False"
      Opacity="0.25">

      <Rectangle x:Name="FrontLight1ImageBeam" Style="{StaticResource FrontImageBeamStyle}">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="FrontLight1Scale" CenterX="0.12" CenterY="1" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="FrontLight1Rotate" CenterX="0.12" CenterY="1" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="0.07" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="0.12" Color="{DynamicResource FrontImageBeamPeakColor}" />
            <GradientStop Offset="0.17" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="1" Color="{StaticResource FrontImageBeamEdgeColor}" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Rectangle x:Name="FrontLight2ImageBeam" Style="{StaticResource FrontImageBeamStyle}">

        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <LinearGradientBrush.RelativeTransform>
              <TransformGroup>
                <ScaleTransform x:Name="FrontLight2Scale" CenterX="0.88" CenterY="1" ScaleX="1" ScaleY="1" />
                <RotateTransform x:Name="FrontLight2Rotate" CenterX="0.88" CenterY="1" />
              </TransformGroup>
            </LinearGradientBrush.RelativeTransform>

            <GradientStop Offset="0" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="0.83" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="0.88" Color="{DynamicResource FrontImageBeamPeakColor}" />
            <GradientStop Offset="0.93" Color="{StaticResource FrontImageBeamEdgeColor}" />
            <GradientStop Offset="1" Color="{StaticResource FrontImageBeamEdgeColor}" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Grid>
  </Grid>
</UserControl>
