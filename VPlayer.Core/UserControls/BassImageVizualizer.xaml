<UserControl
  x:Class="VPlayer.Player.UserControls.BassImageVizualizer"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:VPlayer.Player.UserControls"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">

  <Grid>
    <Grid ClipToBounds="True">

      <Grid
        x:Name="BassImageContainer"
        Opacity="1"
        RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="BassImageScale" ScaleX="1" ScaleY="1" />
            <RotateTransform x:Name="BassImageRotate" Angle="0" />
          </TransformGroup>
        </Grid.RenderTransform>

        <Image
          x:Name="OriginalImage"
          Opacity="0"
          RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Image
          x:Name="RedImage"
          Opacity="0"
          RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Image
          x:Name="GreenImage"
          Opacity="0"
          RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Image
          x:Name="BlueImage"
          Margin="0,0,0,0"
          Opacity="0"
          RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Grid>

      <Grid RenderTransformOrigin="0.5,0.5">
        <Image
          x:Name="StableImage"
          Opacity="1"
          RenderOptions.BitmapScalingMode="NearestNeighbor" />
      </Grid>
    </Grid>
  </Grid>



</UserControl>
